  "paths": {
    "/rooms": {
      "get": {
        "tags": [
          "Rooms"
        ],
        "summary": "Get all rooms",
        "description": "Returns all application rooms",
        "responses": {
          "200": {
            "description": "Rooms retrieved successfully",
            "schema": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "roomName": {
                    "type": "string",
                    "example": "General Chat"
                  },
                  "users": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "username": {
                          "type": "string",
                          "example": "maria456"
                        }
                      }
                    }
                  }
                }
              },
              "xml": {
                "name": "main"
              }
            },
            "example": [
              {
                "roomName": "General Chat",
                "users": [
                  {
                    "username": "juan123"
                  },
                  {
                    "username": "maria456"
                  }
                ]
              }
            ]
          }
        }
      },
      "post": {
        "tags": [
          "Rooms"
        ],
        "summary": "Create rooms",
        "description": "Create a room",
        "responses": {
          "200": {
            "description": "Rooms Create successfully",
            "schema": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "roomName": {
                    "type": "string",
                    "example": "General Chat"
                  },
                  "username": {
                    "type": "string",
                    "example": "Piero"
                  }
                }
              },
              "xml": {
                "name": "main"
              }
            },
            "example": [
