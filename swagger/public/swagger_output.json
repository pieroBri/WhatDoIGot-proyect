{
  "swagger": "2.0",
  "info": {
    "title": "API What do i got",
    "description": "Documentación de la API para el proyecto What do i got",
    "version": "1.0.0"
  },
  "host": "localhost:3000",
  "basePath": "/",
  "schemes": [
    "http"
